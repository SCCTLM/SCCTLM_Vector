<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0" ExtensionBundleId="vn.scctlm.vector" ExtensionBundleVersion="0.1.0" ExtensionBundleName="SCCTLM Vector"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="vn.scctlm.vector.panel" Version="0.1.0" />
    <Extension Id="vn.scctlm.vector.picker" Version="0.1.0" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="ILST" Version="[26.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="10.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="vn.scctlm.vector.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./loader.html</MainPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>SCCTLM Vector</Menu>
          <Geometry>
            <Size>
              <Width>320</Width>
              <Height>640</Height>
            </Size>
            <MinSize>
              <Width>260</Width>
              <Height>300</Height>
            </MinSize>
            <MaxSize>
              <Width>1200</Width>
              <Height>2400</Height>
            </MaxSize>
          </Geometry>
          <Icons>
            <Icon Type="Normal">./icons/icon.png</Icon>
            <Icon Type="RollOver">./icons/icon.png</Icon>
            <Icon Type="DarkNormal">./icons/icon.png</Icon>
            <Icon Type="DarkRollOver">./icons/icon.png</Icon>
          </Icons>
        </UI>
      </DispatchInfo>
    </Extension>
    <!-- Colour picker window, opened from the panel. Its page lives in the updatable app folder. -->
    <Extension Id="vn.scctlm.vector.picker">
      <DispatchInfo>
        <Resources>
          <MainPath>./picker-loader.html</MainPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Modeless</Type>
          <!-- Opened from the panel's "Màu CMYK" button; no separate Window > Extensions menu entry. -->
          <Geometry>
            <Size>
              <Width>600</Width>
              <Height>410</Height>
            </Size>
          </Geometry>
          <Icons>
            <Icon Type="Normal">./icons/icon.png</Icon>
            <Icon Type="RollOver">./icons/icon.png</Icon>
            <Icon Type="DarkNormal">./icons/icon.png</Icon>
            <Icon Type="DarkRollOver">./icons/icon.png</Icon>
          </Icons>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
